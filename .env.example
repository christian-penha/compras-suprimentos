SECRET_KEY=gerar-uma-chave-secreta
DEBUG=True
DATABASE_URL=postgres://usuario:senha@localhost:5432/compras_suprimentos
ALLOWED_HOSTS=localhost,127.0.0.1

# Login com Google (opcional). Crie o ID de cliente em console.cloud.google.com > Credenciais.
# URI de redirecionamento autorizado: http://localhost:8001/auth/authorize/google/ (com a barra final)
# O Google só aceita localhost ou domínio público (não IP de rede como 192.168.x.x).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domínios permitidos, separados por vírgula (vazio = qualquer conta Google já cadastrada)
GOOGLE_ALLOWED_DOMAINS=
