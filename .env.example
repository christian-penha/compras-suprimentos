SECRET_KEY=gerar-uma-chave-secreta
DEBUG=True
DATABASE_URL=postgres://usuario:senha@localhost:5432/compras_suprimentos
ALLOWED_HOSTS=localhost,127.0.0.1

# Login com Google (opcional). Crie o ID de cliente em console.cloud.google.com > Credenciais.
# URI de redirecionamento autorizado: http://localhost:8001/auth/authorize/google/ (com a barra final)
# O Google só aceita localhost ou domínio público (não IP de rede como 192.168.x.x).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domínios permitidos, separados por vírgula (vazio = qualquer conta Google já cadastrada)
GOOGLE_ALLOWED_DOMAINS=

# --- Docker / Portainer (docker-compose.yml) ---
# SECRET_KEY: gere com  python -c "import secrets; print(secrets.token_urlsafe(60))"
POSTGRES_PASSWORD=
APP_PORT=8001
# Endereco(s) de acesso, sem http://  ex.: ALLOWED_HOSTS=compras.exemplo.com.br,192.168.0.10
# Origens completas para login/formularios  ex.: CSRF_TRUSTED_ORIGINS=http://192.168.0.10:8001
# HTTPS=True somente com proxy reverso + certificado na frente.
HTTPS=False
# Administrador criado no primeiro start do container (opcional)
DJANGO_ADMIN_USER=
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
